# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Penasihat Fashion AI (/creator → Tanya AI)
# Buat key di https://aistudio.google.com/apikey — jangan commit key asli
GEMINI_API_KEY=your-gemini-api-key
# Opsional jika model default sibuk: GEMINI_MODEL=gemini-2.5-flash-lite
# Opsional cadangan: XAI_API_KEY=your-xai-api-key
